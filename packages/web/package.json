{
  "name": "@backbone/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backbone pipeline web UI — analyse, review/edit the Blueprint, generate, regenerate.",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,green \"pnpm server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview --port 5177",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backbone/analyzer": "workspace:*",
    "@backbone/core": "workspace:*",
    "@backbone/generators": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "marked": "^14.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
