{
  "name": "@backbone/analyzer",
  "version": "0.1.0",
  "description": "Deterministic static analysis of a React+TS frontend into a Backbone Blueprint (ts-morph).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@backbone/core": "workspace:*",
    "ts-morph": "^24.0.0",
    "typescript": "^5.6.3"
  }
}
