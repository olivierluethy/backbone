def _token(user) -> dict:
    refresh = RefreshToken.for_user(user)
    return {
        "token": str(refresh.access_token),
        "user": {"id": user.id, "email": user.email, "role": user.role},
    }


class RegisterView(APIView):
    permission_classes = [AllowAny]

    def post(self, request):
        data = RegisterSerializer(data=request.data)
        data.is_valid(raise_exception=True)
        payload = data.validated_data
        if User.objects.filter(email=payload["email"]).exists():
            return Response({"detail": "Email already registered"}, status=status.HTTP_409_CONFLICT)
        user = User(username=payload["email"], email=payload["email"], role=DEFAULT_ROLE)
<% for (const c of view.authUserExtraColumns) { -%>
        setattr(user, "<%= c.name %>", payload.get("<%= c.name %>"))
<% } -%>
        user.set_password(payload["password"])
        user.save()
        return Response(_token(user), status=status.HTTP_201_CREATED)


class LoginView(APIView):
    permission_classes = [AllowAny]

    def post(self, request):
        user = User.objects.filter(email=request.data.get("email")).first()
        if user is None or not user.check_password(request.data.get("password", "")):
            return Response({"detail": "Invalid credentials"}, status=status.HTTP_401_UNAUTHORIZED)
        return Response(_token(user))


class MeView(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request):
        user = request.user
        return Response({"id": user.id, "email": user.email, "role": user.role})
