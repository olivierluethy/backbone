<?php

declare(strict_types=1);

namespace App\Generated\Auth;

use App\Generated\Config\Database;
use App\Generated\Config\Env;
use App\Generated\Support\HttpException;
use Firebase\JWT\JWT;

/** Auth logic over the reserved `users` table. Generated by Backbone — do not edit. */
final class AuthService
{
    private const TABLE = 'users';
    private const DEFAULT_ROLE = '<%= view.auth.roles[0] || "member" %>';

    public function register(array $input): array
    {
        $pdo = Database::pdo();
        $existing = $pdo->prepare('SELECT id FROM ' . self::TABLE . ' WHERE email = ?');
        $existing->execute([$input['email']]);
        if ($existing->fetch()) {
            throw new HttpException(409, 'Email already registered');
        }

        $columns = ['email', 'password_hash', 'role'<% for (const c of view.authUserExtraColumns) { %>, '<%= c.name %>'<% } %>, 'created_at'];
        $values = [
            $input['email'],
            password_hash((string) $input['password'], PASSWORD_BCRYPT),
            self::DEFAULT_ROLE,
<% for (const c of view.authUserExtraColumns) { -%>
            $input['<%= c.field %>'] ?? null,
<% } -%>
            gmdate('c'),
        ];
        $placeholders = implode(', ', array_fill(0, count($columns), '?'));
        $sql = 'INSERT INTO ' . self::TABLE . ' (' . implode(', ', $columns) . ') VALUES (' . $placeholders . ')';
        $pdo->prepare($sql)->execute($values);

        $user = $this->findById((int) $pdo->lastInsertId());
        return ['token' => $this->sign($user), 'user' => $this->publicUser($user)];
    }

    public function login(array $input): array
    {
        $user = $this->findByEmail((string) $input['email']);
        if ($user === null || !password_verify((string) $input['password'], (string) $user['password_hash'])) {
            throw new HttpException(401, 'Invalid credentials');
        }
        return ['token' => $this->sign($user), 'user' => $this->publicUser($user)];
    }

    public function me(int $id): array
    {
        $user = $this->findById($id);
        if ($user === null) {
            throw new HttpException(404, 'User not found');
        }
        return $this->publicUser($user);
    }

    private function findById(int $id): ?array
    {
        $stmt = Database::pdo()->prepare('SELECT * FROM ' . self::TABLE . ' WHERE id = ?');
        $stmt->execute([$id]);
        $row = $stmt->fetch();
        return $row === false ? null : $row;
    }

    private function findByEmail(string $email): ?array
    {
        $stmt = Database::pdo()->prepare('SELECT * FROM ' . self::TABLE . ' WHERE email = ?');
        $stmt->execute([$email]);
        $row = $stmt->fetch();
        return $row === false ? null : $row;
    }

    private function sign(array $user): string
    {
        $ttl = (int) (Env::get('JWT_EXPIRES_IN', '604800'));
        $payload = [
            'id' => (int) $user['id'],
            'email' => $user['email'],
            'role' => $user['role'],
            'iat' => time(),
            'exp' => time() + $ttl,
        ];
        return JWT::encode($payload, (string) Env::get('JWT_SECRET', 'change-me-in-production'), 'HS256');
    }

    private function publicUser(array $user): array
    {
        return ['id' => (int) $user['id'], 'email' => $user['email'], 'role' => $user['role']];
    }
}
