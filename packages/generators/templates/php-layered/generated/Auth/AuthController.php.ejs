namespace App\Generated\Auth;

use App\Generated\Support\HttpException;
use App\Generated\Support\Request;
use App\Generated\Support\Response;

/** Auth HTTP handlers: register / login / me. Generated by Backbone — do not edit. */
final class AuthController
{
    private AuthService $service;

    public function __construct()
    {
        $this->service = new AuthService();
    }

    public function register(array $params, ?array $user): void
    {
        $data = AuthValidator::validateRegister(Request::body());
        Response::json($this->service->register($data), 201);
    }

    public function login(array $params, ?array $user): void
    {
        $data = AuthValidator::validateLogin(Request::body());
