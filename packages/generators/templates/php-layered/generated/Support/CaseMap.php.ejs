<?php

declare(strict_types=1);

namespace App\Generated\Support;

/**
 * camelCase (JSON API) <-> snake_case (DB columns) mapping, so the API stays camelCase while
 * columns stay snake_case. Generated by Backbone — do not edit.
 */
final class CaseMap
{
    public static function camelToSnake(string $s): string
    {
        return strtolower((string) preg_replace('/([a-z0-9])([A-Z])/', '$1_$2', $s));
    }

    public static function snakeToCamel(string $s): string
    {
        return lcfirst(str_replace(' ', '', ucwords(str_replace('_', ' ', $s))));
    }

    /** Map array keys camelCase -> snake_case (one level). */
    public static function keysToSnake(array $row): array
    {
        $out = [];
        foreach ($row as $key => $value) {
            $out[self::camelToSnake((string) $key)] = $value;
        }
        return $out;
    }

    /** Map array keys snake_case -> camelCase (one level). */
    public static function keysToCamel(array $row): array
    {
        $out = [];
        foreach ($row as $key => $value) {
            $out[self::snakeToCamel((string) $key)] = $value;
        }
        return $out;
    }
}
