{
    "name": "backbone/backend",
    "description": "Backend generated by Backbone from a frontend Blueprint.",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^6.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "serve": "php -S localhost:4001 public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}
