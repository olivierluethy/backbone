import { Body, Controller, Get, Post, Req, UseGuards } from "@nestjs/common";
import { AuthService } from "./auth.service";
import { JwtGuard } from "./jwt.guard";
import { RegisterDto } from "./dto/register.dto";
import { LoginDto } from "./dto/login.dto";

/**
 * Authentication HTTP controller. Backbone owns this file — do not edit.
 *
 * Exposes `POST /auth/register`, `POST /auth/login` and `GET /auth/me`. The `me` endpoint is
 * protected by JwtGuard, which populates `request.user` from the verified token; its `sub`
 * claim is the authenticated user's id.
 */
@Controller("auth")
export class AuthController {
  constructor(private readonly service: AuthService) {}

  // POST /auth/register — create an account and return a JWT.
  @Post("register")
  register(@Body() dto: RegisterDto) {
    return this.service.register(dto);
  }

  // POST /auth/login — exchange credentials for a JWT.
  @Post("login")
  login(@Body() dto: LoginDto) {
    return this.service.login(dto);
  }

  // GET /auth/me — return the current user (requires a valid bearer token).
  @UseGuards(JwtGuard)
  @Get("me")
  me(@Req() req: any) {
    return this.service.me(req.user.sub);
  }
}
