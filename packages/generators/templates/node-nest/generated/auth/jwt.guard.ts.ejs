import { CanActivate, ExecutionContext, Injectable, UnauthorizedException } from "@nestjs/common";
import { JwtService } from "@nestjs/jwt";

/**
 * Route guard that enforces JWT authentication. Backbone owns this file — do not edit.
 *
 * Applied via `@UseGuards(JwtGuard)` on any endpoint the Blueprint marked as requiring auth. It
 * reads the `Authorization: Bearer <token>` header, verifies the token with @nestjs/jwt (using
 * the secret configured in AuthModule) and attaches the decoded payload to `request.user`.
 * AuthModule is @Global, so this guard's JwtService dependency resolves in every module.
 */
@Injectable()
export class JwtGuard implements CanActivate {
  constructor(private readonly jwt: JwtService) {}

  canActivate(context: ExecutionContext): boolean {
    const request = context.switchToHttp().getRequest();
    const header: string = request.headers?.authorization ?? "";
    const token = header.startsWith("Bearer ") ? header.slice(7) : null;
    if (!token) throw new UnauthorizedException("Missing bearer token");
    try {
      // Verify signature + expiry and expose the claims to downstream handlers.
      request.user = this.jwt.verify(token);
      return true;
    } catch {
      throw new UnauthorizedException("Invalid or expired token");
    }
  }
}
