# Server
PORT=4000

# Database — SQLite by default (zero setup). TypeORM opens this file and, with
# synchronize enabled in development, creates the schema from the entity metadata on boot.
DB_FILE=./data.sqlite
<% if (view.dialect !== "sqlite") { -%>
# MySQL connection (this Blueprint targets MySQL).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=backbone
<% } -%>
<% if (auth) { %>
# Auth — secret used to sign and verify JWTs. Change this before deploying.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
<% } %>
