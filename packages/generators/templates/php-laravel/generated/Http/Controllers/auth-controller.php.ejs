<?php

declare(strict_types=1);

namespace App\Generated\Http\Controllers;

use App\Generated\Models\User;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Hash;

/**
 * Authentication controller: register / login / me.
 *
 * Passwords are hashed with `Hash::make` (bcrypt). On success a compact, self-contained bearer
 * token is issued — a base64 JSON payload signed with an HMAC over APP_KEY — so no extra package
 * (Sanctum/Passport) is required to run. `me` verifies that token. Swap in Laravel Sanctum when
 * you need revocation or SPA cookies. Generated by Backbone — do not edit.
 */
class AuthController
{
    /** Token lifetime in seconds (7 days). */
    private const TOKEN_TTL = 604800;

    /** The default role assigned to newly registered users. */
    private const DEFAULT_ROLE = '<%= role %>';

    /**
     * POST /auth/register — create a user and return a signed token.
     * Rejects duplicate emails with HTTP 409.
     */
    public function register(Request $request): JsonResponse
    {
        $data = $request->validate([
            'email' => 'required|email',
            'password' => 'required|string|min:6',
<% for (const c of extra) { -%>
            '<%= c.field %>' => '<%= lv.rule(c, true) %>',
<% } -%>
        ]);

        if (User::where('email', $data['email'])->exists()) {
            return response()->json(['message' => 'Email already registered'], 409);
        }

        $user = User::create([
            'email' => $data['email'],
            'password_hash' => Hash::make($data['password']),
            'role' => self::DEFAULT_ROLE,
<% for (const c of extra) { -%>
            '<%= c.name %>' => $data['<%= c.field %>'] ?? null,
<% } -%>
        ]);

        return response()->json([
            'token' => $this->issueToken($user),
            'user' => $this->publicUser($user),
        ], 201);
    }

    /**
     * POST /auth/login — verify credentials and return a signed token (401 on mismatch).
     */
    public function login(Request $request): JsonResponse
    {
        $data = $request->validate([
            'email' => 'required|email',
            'password' => 'required|string',
        ]);

        $user = User::where('email', $data['email'])->first();
        if ($user === null || !Hash::check($data['password'], $user->password_hash)) {
            return response()->json(['message' => 'Invalid credentials'], 401);
        }

        return response()->json([
            'token' => $this->issueToken($user),
            'user' => $this->publicUser($user),
        ]);
    }

    /**
     * GET /auth/me — return the current user for a valid bearer token (401 otherwise).
     */
    public function me(Request $request): JsonResponse
    {
        $user = $this->userFromRequest($request);
        if ($user === null) {
            return response()->json(['message' => 'Not authenticated'], 401);
        }

        return response()->json($this->publicUser($user));
    }

    /* ------------------------------------------------------------------ *
     * Minimal, self-contained token helpers (no external auth package).
     * ------------------------------------------------------------------ */

    /** Sign a `<base64 payload>.<hmac>` token for the given user. */
    private function issueToken(User $user): string
    {
        $payload = base64_encode((string) json_encode([
            'id' => $user->id,
            'exp' => time() + self::TOKEN_TTL,
        ]));

        return $payload . '.' . $this->sign($payload);
    }

    /** Resolve the user carried by the request's `Authorization: Bearer <token>` header, or null. */
    private function userFromRequest(Request $request): ?User
    {
        $header = (string) $request->header('Authorization', '');
        if (!str_starts_with($header, 'Bearer ')) {
            return null;
        }

        [$payload, $signature] = array_pad(explode('.', substr($header, 7), 2), 2, '');
        // Constant-time compare guards against signature-forgery timing attacks.
        if ($payload === '' || !hash_equals($this->sign($payload), $signature)) {
            return null;
        }

        $claims = json_decode((string) base64_decode($payload), true);
        if (!is_array($claims) || (int) ($claims['exp'] ?? 0) < time()) {
            return null;
        }

        return User::find($claims['id'] ?? 0);
    }

    /** HMAC-SHA256 the payload with the application key. */
    private function sign(string $payload): string
    {
        return hash_hmac('sha256', $payload, (string) config('app.key'));
    }

    /** The public projection of a user (never includes the password hash). */
    private function publicUser(User $user): array
    {
        return [
            'id' => $user->id,
            'email' => $user->email,
            'role' => $user->role,
        ];
    }
}
