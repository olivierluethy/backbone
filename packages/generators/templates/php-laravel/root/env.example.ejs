# ---------------------------------------------------------------------------
# Environment for the Backbone-generated Laravel 11 backend.
# Copy to `.env`, then run `php artisan key:generate` to fill APP_KEY.
# ---------------------------------------------------------------------------
APP_NAME=Backbone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Database: SQLite by default (zero setup). ---
# The default connection points at database/database.sqlite. Create it with:
#   touch database/database.sqlite
DB_CONNECTION=sqlite
# For an explicit path, uncomment and set an absolute path:
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# For MySQL instead, switch the connection and fill these in:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=backbone
# DB_USERNAME=root
# DB_PASSWORD=
<% if (auth) { -%>

# --- Auth ---
# The generated AuthController signs its tokens with APP_KEY (HMAC-SHA256),
# so no extra secret is required. Token lifetime is fixed at 7 days.
<% } -%>
