{
    "name": "backbone/laravel-backend",
    "type": "project",
    "description": "Laravel 11 backend generated by Backbone from a frontend Blueprint.",
    "keywords": ["laravel", "backbone", "generated"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "suggest": {
        "laravel/sanctum": "Add token/SPA authentication (^4.0) — this scaffold ships a minimal self-contained token instead."
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
