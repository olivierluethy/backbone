# Copy this file to `.env` (or `.env.local`) before running the app.

# Symfony environment
APP_ENV=dev
APP_DEBUG=1
# Random secret used by the framework AND to HMAC-sign auth tokens. CHANGE IT in production.
APP_SECRET=change-me-in-production

# Database — SQLite by default (zero setup); the file is created under var/.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# For MySQL instead, comment the line above and use:
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/backbone?serverVersion=8.0&charset=utf8mb4"
