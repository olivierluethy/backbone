import "dotenv/config";
import type { Knex } from "knex";

/**
 * Knex configuration. SQLite by default (zero setup); set DB_CLIENT=mysql2 with the MySQL
 * env vars to switch. Generated by Backbone — safe to edit.
 */
const dialect = process.env.DB_CLIENT ?? "better-sqlite3";

const config: Knex.Config =
  dialect === "mysql2"
    ? {
        client: "mysql2",
        connection: {
          host: process.env.DB_HOST ?? "127.0.0.1",
          port: Number(process.env.DB_PORT ?? 3306),
          user: process.env.DB_USER ?? "root",
          password: process.env.DB_PASSWORD ?? "",
          database: process.env.DB_NAME ?? "backbone",
        },
        migrations: { directory: "./migrations", loadExtensions: [".ts"] },
      }
    : {
        client: "better-sqlite3",
        connection: { filename: process.env.DB_FILE ?? "./data.sqlite" },
        useNullAsDefault: true,
        migrations: { directory: "./migrations", loadExtensions: [".ts"] },
      };

export default config;
