# Environment configuration for the Flask backend. Copy this file to `.env`; python-dotenv
# loads it in the create_app() factory. Values here are safe development defaults.

# Server port used by wsgi.py / the Flask dev server.
PORT=4200

# Database — SQLite by default (zero setup, file created next to the app). For MySQL or
# Postgres set a full SQLAlchemy URL instead.
DATABASE_URL=sqlite:///./data.sqlite
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/backbone
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/backbone
<% if (auth) { %>
# Auth — HS256 JWT signing secret and token lifetime (minutes). CHANGE THE SECRET in prod.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=10080
<% } %>