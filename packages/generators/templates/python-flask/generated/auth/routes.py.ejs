"""Authentication routes (Flask Blueprint): register / login / me.

Generated by Backbone — do not edit (regenerated wholesale).

  - POST /auth/register  — create an account, returns { token, user }
  - POST /auth/login     — exchange credentials for a token, returns { token, user }
  - GET  /auth/me        — the current user (requires a valid Bearer token)

Validation and conflict handling live in the auth service; here we translate its AuthError
into the right HTTP status. Successful responses use the user's safe camelCase `to_dict()`.
"""
from flask import Blueprint, g, jsonify, request

from . import service
from .service import AuthError
from .decorators import require_auth

# Blueprint mounting the auth endpoints; registered by app/generated/api.py.
bp = Blueprint("auth", __name__)


@bp.post("/auth/register")
def register():
    """Register a new account and return a signed token plus the public user view."""
    try:
        result = service.register(request.get_json(silent=True) or {})
    except AuthError as exc:
        return jsonify({"error": str(exc)}), exc.status
    return jsonify(result), 201


@bp.post("/auth/login")
def login():
    """Authenticate credentials and return a signed token plus the public user view."""
    try:
        result = service.login(request.get_json(silent=True) or {})
    except AuthError as exc:
        return jsonify({"error": str(exc)}), exc.status
    return jsonify(result)


@bp.get("/auth/me")
@require_auth
def me():
    """Return the currently authenticated user (populated by require_auth)."""
    return jsonify(g.current_user.to_dict())
