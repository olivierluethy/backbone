"""
from flask import Blueprint, jsonify, request

from ..services import <%= e.varName %> as service
from ..schemas.<%= e.varName %> import validate_create, validate_update
<% if (anyAuth) { -%>
from ..auth.decorators import require_auth
<% } -%>

# Blueprint mounting all <%= e.name %> routes; registered by app/generated/api.py.
bp = Blueprint("<%= e.varName %>", __name__)

<% for (const ep of e.endpoints) {
     const rule = fl.route(ep.httpPath, e.pkType);
     const param = fl.paramName(ep.httpPath) || "item_id";
     const method = ep.method.toLowerCase();
     const guard = ep.auth ? "@require_auth\n" : "";
     if (ep.operation === "list") { -%>
@bp.get("<%- rule %>")
<%- guard %>def list_<%= e.varName %>():
    """List every <%= e.name %>."""
    items = service.list_all()
    return jsonify([item.to_dict() for item in items])

<%   } else if (ep.operation === "read") { -%>
@bp.get("<%- rule %>")
<%- guard %>def get_<%= e.varName %>(<%= param %>: <%= idPy %>):
    """Fetch one <%= e.name %> by id, or 404 if it does not exist."""
    obj = service.get(<%= param %>)
    if obj is None:
        return jsonify({"error": "<%= e.name %> not found"}), 404
    return jsonify(obj.to_dict())

<%   } else if (ep.operation === "create") { -%>
@bp.post("<%- rule %>")
<%- guard %>def create_<%= e.varName %>():
    """Create a <%= e.name %> from a validated JSON body (400 on invalid input)."""
    try:
        data = validate_create(request.get_json(silent=True) or {})
    except ValueError as exc:
        return jsonify({"error": str(exc)}), 400
    obj = service.create(data)
    return jsonify(obj.to_dict()), 201

<%   } else if (ep.operation === "update") { -%>
@bp.<%= method %>("<%- rule %>")
<%- guard %>def update_<%= e.varName %>(<%= param %>: <%= idPy %>):
    """Update an existing <%= e.name %> (404 if missing, 400 on invalid input)."""
    obj = service.get(<%= param %>)
    if obj is None:
        return jsonify({"error": "<%= e.name %> not found"}), 404
    try:
        data = validate_update(request.get_json(silent=True) or {})
    except ValueError as exc:
        return jsonify({"error": str(exc)}), 400
    obj = service.update(obj, data)
    return jsonify(obj.to_dict())

<%   } else if (ep.operation === "delete") { -%>
@bp.delete("<%- rule %>")
<%- guard %>def delete_<%= e.varName %>(<%= param %>: <%= idPy %>):
    """Delete a <%= e.name %> by id (404 if missing, 204 on success)."""
    obj = service.get(<%= param %>)
    if obj is None:
        return jsonify({"error": "<%= e.name %> not found"}), 404
    service.delete(obj)
    return "", 204

<%   } } -%>
