"""Blueprint registry — mounts every generated blueprint onto the Flask app.

Generated by Backbone — do not edit (regenerated wholesale).

`register_blueprints(app)` is called once from the create_app() factory. It wires up:
<% for (const e of view.entities) { -%>
  - the <%= e.name %> blueprint (routes under <%= e.routeBase %>),
<% } -%>
<% if (auth) { -%>
  - the auth blueprint (register / login / me under /auth).
<% } -%>
"""
<% for (const e of view.entities) { -%>
from .routes.<%= e.varName %> import bp as <%= e.varName %>_bp
<% } -%>
<% if (auth) { -%>
from .auth.routes import bp as auth_bp
<% } -%>


def register_blueprints(app) -> None:
    """Attach all Backbone-generated blueprints to the application."""
<% if (auth) { -%>
    # Authentication endpoints (register / login / me).
    app.register_blueprint(auth_bp)
<% } -%>
<% for (const e of view.entities) { -%>
    # <%= e.name %> resource endpoints.
    app.register_blueprint(<%= e.varName %>_bp)
<% } -%>
<% if (view.entities.length === 0 && !auth) { -%>
    # No entities or auth detected in the Blueprint — nothing to register.
    return
<% } -%>
