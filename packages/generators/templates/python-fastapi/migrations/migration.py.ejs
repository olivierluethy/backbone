<% const roleDefault = (view.auth.roles[0] || "member"); -%>
"""<%= plan.slug %> — generated by Backbone.

Additive only — never edit or delete this file; regeneration appends new revisions.
"""
from alembic import op
import sqlalchemy as sa

revision = "<%= revision %>"
down_revision = <%- downRevision ? `"${downRevision}"` : "None" %>
branch_labels = None
depends_on = None


def upgrade() -> None:
<% if (isInit && view.hasAuth) { -%>
    op.create_table(
        "users",
        sa.Column("id", sa.Integer(), primary_key=True, autoincrement=True),
        sa.Column("email", sa.String(), nullable=False, unique=True),
        sa.Column("password_hash", sa.String(), nullable=False),
        sa.Column("role", sa.String(), nullable=False, server_default="<%= roleDefault %>"),
<% for (const c of view.authUserExtraColumns) { -%>
        <%- py.alembicColumn(c) %>,
<% } -%>
        sa.Column("created_at", sa.DateTime(), nullable=False),
    )
<% } -%>
<% for (const e of plan.newTables) { -%>
    op.create_table(
        "<%= e.table %>",
<% for (const c of e.columns) { -%>
        <%- py.alembicColumn(c) %>,
<% } -%>
    )
<% } -%>
<% for (const j of plan.newJoinTables) { -%>
    op.create_table(
        "<%= j.name %>",
        sa.Column("<%= j.leftFk %>", sa.Integer(), sa.ForeignKey("<%= j.left %>.id", ondelete="CASCADE"), primary_key=True),
        sa.Column("<%= j.rightFk %>", sa.Integer(), sa.ForeignKey("<%= j.right %>.id", ondelete="CASCADE"), primary_key=True),
    )
<% } -%>
<% for (const a of plan.addedColumns) { -%>
    with op.batch_alter_table("<%= a.table %>") as batch_op:
        batch_op.add_column(<%- py.alembicAddColumn(a.column) %>)
<% } -%>
<% if (!isInit && plan.newTables.length === 0 && plan.newJoinTables.length === 0 && plan.addedColumns.length === 0) { -%>
    pass
<% } -%>


def downgrade() -> None:
<% for (const a of [...plan.addedColumns].reverse()) { -%>
    with op.batch_alter_table("<%= a.table %>") as batch_op:
        batch_op.drop_column("<%= a.column.name %>")
<% } -%>
<% for (const j of plan.newJoinTables) { -%>
    op.drop_table("<%= j.name %>")
<% } -%>
<% for (const e of [...plan.newTables].reverse()) { -%>
    op.drop_table("<%= e.table %>")
<% } -%>
<% if (isInit && view.hasAuth) { -%>
    op.drop_table("users")
<% } -%>
<% if (!isInit && plan.newTables.length === 0 && plan.newJoinTables.length === 0 && plan.addedColumns.length === 0) { -%>
    pass
<% } -%>
