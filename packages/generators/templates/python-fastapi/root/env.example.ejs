# Server
PORT=4200

# Database — SQLite by default (zero setup). For MySQL/Postgres, set a full DATABASE_URL.
DATABASE_URL=sqlite:///./data.sqlite
# DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/backbone
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/backbone
<% if (auth) { %>
# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=10080
<% } %>
