"""Application entry point. Backbone writes this once and never touches it again.
The generated API lives under app/generated/; add your own routes where marked."""
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from app.generated.routers import api_router

app = FastAPI(title="Backbone backend")

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


@app.get("/health")
def health() -> dict:
    return {"status": "ok"}


# --- Backbone-generated API ---
app.include_router(api_router)

