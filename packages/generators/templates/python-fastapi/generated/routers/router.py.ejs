<% const idPy = e.pkType === "uuid" ? "str" : "int";
   const anyAuth = e.endpoints.some((ep) => ep.auth); -%>
"""Routes for <%= e.name %> (only endpoints detected in the frontend). Generated by Backbone — do not edit."""
from fastapi import APIRouter, Depends
from sqlalchemy.orm import Session

from ..core.db import get_db
from ..schemas.<%= e.varName %> import <%= e.className %>Create, <%= e.className %>Read, <%= e.className %>Update
from ..services import <%= e.varName %> as service
<% if (anyAuth) { -%>
from ..auth.deps import get_current_user
<% } -%>

router = APIRouter(tags=["<%= e.className %>"])

<% for (const ep of e.endpoints) {
     const path = py.path(ep.httpPath);
     const m = ep.httpPath.match(/:([A-Za-z0-9_]+)/);
     const param = m ? m[1] : "item_id";
     const guard = ep.auth ? ", dependencies=[Depends(get_current_user)]" : "";
     if (ep.operation === "list") { -%>
@router.get("<%= path %>", response_model=list[<%= e.className %>Read]<%- guard %>)
def list_<%= e.varName %>(db: Session = Depends(get_db)):
    return service.list_(db)

<%   } else if (ep.operation === "read") { -%>
@router.get("<%= path %>", response_model=<%= e.className %>Read<%- guard %>)
def get_<%= e.varName %>(<%= param %>: <%= idPy %>, db: Session = Depends(get_db)):
    return service.get(db, <%= param %>)

<%   } else if (ep.operation === "create") { -%>
@router.post("<%= path %>", response_model=<%= e.className %>Read, status_code=201<%- guard %>)
def create_<%= e.varName %>(payload: <%= e.className %>Create, db: Session = Depends(get_db)):
    return service.create(db, payload)

<%   } else if (ep.operation === "update") { -%>
@router.<%= ep.method.toLowerCase() %>("<%= path %>", response_model=<%= e.className %>Read<%- guard %>)
def update_<%= e.varName %>(<%= param %>: <%= idPy %>, payload: <%= e.className %>Update, db: Session = Depends(get_db)):
    return service.update(db, <%= param %>, payload)

<%   } else if (ep.operation === "delete") { -%>
@router.delete("<%= path %>", status_code=204<%- guard %>)
def delete_<%= e.varName %>(<%= param %>: <%= idPy %>, db: Session = Depends(get_db)):
    service.remove(db, <%= param %>)
    return None

<%   } } -%>
