<% const hasCreated = e.columns.some((c) => c.name === "created_at");
   const hasUpdated = e.columns.some((c) => c.name === "updated_at");
   const idPy = e.pkType === "uuid" ? "str" : "int"; -%>
"""Business layer for <%= e.name %>. Generated by Backbone — do not edit."""
from datetime import datetime, timezone

from fastapi import HTTPException
from sqlalchemy.orm import Session

from ..models.<%= e.varName %> import <%= e.className %>
from ..schemas.<%= e.varName %> import <%= e.className %>Create, <%= e.className %>Update


def list_(db: Session) -> list[<%= e.className %>]:
    return db.query(<%= e.className %>).all()


def get(db: Session, item_id: <%= idPy %>) -> <%= e.className %>:
    obj = db.get(<%= e.className %>, item_id)
    if obj is None:
        raise HTTPException(status_code=404, detail="<%= e.name %> not found")
    return obj


def create(db: Session, data: <%= e.className %>Create) -> <%= e.className %>:
    obj = <%= e.className %>(**data.model_dump(by_alias=False))
<% if (hasCreated) { -%>
    obj.created_at = datetime.now(timezone.utc)
<% } -%>
<% if (hasUpdated) { -%>
    obj.updated_at = datetime.now(timezone.utc)
<% } -%>
    db.add(obj)
    db.commit()
    db.refresh(obj)
    return obj


def update(db: Session, item_id: <%= idPy %>, data: <%= e.className %>Update) -> <%= e.className %>:
    obj = get(db, item_id)
    for key, value in data.model_dump(by_alias=False, exclude_unset=True).items():
        setattr(obj, key, value)
<% if (hasUpdated) { -%>
    obj.updated_at = datetime.now(timezone.utc)
<% } -%>
    db.commit()
    db.refresh(obj)
    return obj


def remove(db: Session, item_id: <%= idPy %>) -> None:
    obj = get(db, item_id)
    db.delete(obj)
    db.commit()
