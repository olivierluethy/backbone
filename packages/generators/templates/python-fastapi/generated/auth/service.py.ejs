"""Auth logic over the reserved `users` table. Generated by Backbone — do not edit."""
from datetime import datetime, timezone

from fastapi import HTTPException
from sqlalchemy.orm import Session

from ..core.security import create_access_token, hash_password, verify_password
from ..models.user import User
from .schemas import LoginInput, RegisterInput

DEFAULT_ROLE = "<%= view.auth.roles[0] || "member" %>"


def _token(user: User) -> dict:
    payload = {"id": user.id, "email": user.email, "role": user.role}
    return {"token": create_access_token(payload), "user": payload}


def register(db: Session, data: RegisterInput) -> dict:
    if db.query(User).filter(User.email == data.email).first():
        raise HTTPException(status_code=409, detail="Email already registered")
    user = User(
        email=data.email,
        password_hash=hash_password(data.password),
        role=DEFAULT_ROLE,
        created_at=datetime.now(timezone.utc),
    )
<% for (const c of view.authUserExtraColumns) { -%>
    setattr(user, "<%= c.name %>", getattr(data, "<%= c.name %>", None))
<% } -%>
    db.add(user)
    db.commit()
    db.refresh(user)
    return _token(user)


def login(db: Session, data: LoginInput) -> dict:
    user = db.query(User).filter(User.email == data.email).first()
    if user is None or not verify_password(data.password, user.password_hash):
        raise HTTPException(status_code=401, detail="Invalid credentials")
    return _token(user)
