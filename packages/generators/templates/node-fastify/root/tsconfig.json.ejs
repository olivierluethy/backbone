{
  // TypeScript configuration for the Fastify backend. Type-check only (`tsc --noEmit`); the app
  // is run directly from source by `tsx`, so no build/emit step is required. Generated by Backbone.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "migrations", "knexfile.ts"]
}
