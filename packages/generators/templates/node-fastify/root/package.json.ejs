{
  "name": "backbone-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify backend generated by Backbone from a frontend Blueprint.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:rollback": "tsx scripts/migrate.ts --rollback"
  },
  "dependencies": {
<% if (auth) { -%>
    "@fastify/jwt": "^7.2.4",
<% } -%>
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
<% if (auth) { -%>
    "fastify-plugin": "^4.5.1",
<% } -%>
    "knex": "^3.1.0",
    "mysql2": "^3.11.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
