<% const idTs = e.pkType === "uuid" ? "string" : "number"; -%>
import { <%= e.className %>Model } from "../models/<%= e.varName %>.model";
import { HttpError } from "../lib/http-error";
import type { <%= e.className %> } from "../schemas/<%= e.varName %>.schema";

/**
 * Business layer for <%= e.name %>. Sits between the Fastify controllers and the Knex repository:
 * it owns domain rules such as "not found" -> HTTP 404. Generated — do not edit; extend behaviour
 * in your own modules outside `src/generated/` rather than here.
 */
export const <%= e.className %>Service = {
  /** List all <%= e.name %> records. */
  list(): Promise<<%= e.className %>[]> {
    return <%= e.className %>Model.findAll();
  },

  /** Fetch one <%= e.name %> or throw 404 if it does not exist. */
  async get(id: <%= idTs %>): Promise<<%= e.className %>> {
    const found = await <%= e.className %>Model.findById(id);
    if (!found) throw new HttpError(404, "<%= e.name %> not found");
    return found;
  },

  /** Create a new <%= e.name %> from a validated payload. */
  create(data: Partial<<%= e.className %>>): Promise<<%= e.className %>> {
    return <%= e.className %>Model.create(data);
  },

  /** Update an existing <%= e.name %> or throw 404 if it does not exist. */
  async update(id: <%= idTs %>, data: Partial<<%= e.className %>>): Promise<<%= e.className %>> {
    const updated = await <%= e.className %>Model.update(id, data);
    if (!updated) throw new HttpError(404, "<%= e.name %> not found");
    return updated;
  },

  /** Delete a <%= e.name %> or throw 404 if it does not exist. */
  async remove(id: <%= idTs %>): Promise<void> {
    const ok = await <%= e.className %>Model.remove(id);
    if (!ok) throw new HttpError(404, "<%= e.name %> not found");
  },
};
