import "dotenv/config";

/**
 * Typed environment access for the Fastify backend. Every process-level configuration value is
 * read here once and exposed as a plain, strongly-typed object so the rest of the generated code
 * never touches `process.env` directly. Generated — do not edit (regenerated on every run).
 */
export const env = {
  // HTTP port the Fastify server binds to.
  PORT: Number(process.env.PORT ?? 4000),
  // Knex client selection: "better-sqlite3" (default, zero setup) or "mysql2".
  DB_CLIENT: process.env.DB_CLIENT ?? "better-sqlite3",
  // SQLite database file (used when DB_CLIENT is better-sqlite3).
  DB_FILE: process.env.DB_FILE ?? "./data.sqlite",
  // MySQL connection settings (used when DB_CLIENT is mysql2).
  DB_HOST: process.env.DB_HOST ?? "127.0.0.1",
  DB_PORT: Number(process.env.DB_PORT ?? 3306),
  DB_USER: process.env.DB_USER ?? "root",
  DB_PASSWORD: process.env.DB_PASSWORD ?? "",
  DB_NAME: process.env.DB_NAME ?? "backbone",
<% if (auth) { -%>
  // JWT signing secret and lifetime — consumed by the @fastify/jwt plugin. Override JWT_SECRET
  // in production; the default is intentionally obvious so it is never shipped unchanged.
  JWT_SECRET: process.env.JWT_SECRET ?? "change-me-in-production",
  JWT_EXPIRES_IN: process.env.JWT_EXPIRES_IN ?? "7d",
<% } -%>
};
